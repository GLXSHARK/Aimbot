-- ==========================================
-- LOGIKA PEMBUATAN LIST PLAYER & AUTO KILL
-- ==========================================
local function populatePlayerList()
    for _, child in ipairs(ScrollingPlayerList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    local players = Players:GetPlayers()
    ScrollingPlayerList.CanvasSize = UDim2.new(0, 0, 0, #players * 24)
    
    for _, player in ipairs(players) do
        local pBtn = Instance.new("TextButton")
        pBtn.Size = UDim2.new(1, 0, 0, 20)
        pBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
        pBtn.Text = player.Name
        pBtn.TextColor3 = Color3.fromRGB(240, 240, 240)
        pBtn.Font = Enum.Font.Gotham
        pBtn.TextSize = 9
        pBtn.Parent = ScrollingPlayerList
        
        local pCorner = Instance.new("UICorner")
        pCorner.CornerRadius = UDim.new(0, 4)
        pCorner.Parent = pBtn
        
        pBtn.MouseButton1Click:Connect(function()
            selectedAutoKillTarget = player.Name
            AutoKillBtn.Text = "Target: " .. selectedAutoKillTarget
            playerListFrame.Visible = false
            SendNotification("Auto Kill Target", "auto kill " .. selectedAutoKillTarget, Color3.fromRGB(142, 68, 173))
        end)
    end
end

AutoKillBtn.MouseButton1Click:Connect(function()
    playerListFrame.Visible = not playerListFrame.Visible
    if playerListFrame.Visible then
        populatePlayerList()
    end
end)

PlrRefreshBtn.MouseButton1Click:Connect(function()
    populatePlayerList()
end)

AutoKillToggleBtn.MouseButton1Click:Connect(function()
    autoKillEnabled = not autoKillEnabled
    AutoKillToggleBtn.Text = autoKillEnabled and "ON" or "OFF"
    TweenService:Create(AutoKillToggleBtn, TweenInfo.new(0.3), {BackgroundColor3 = autoKillEnabled and Color3.fromRGB(76, 175, 80) or Color3.fromRGB(239, 35, 60)}):Play()
end)

-- Loop Auto Kill Setiap 3 Detik
task.spawn(function()
    while true do
        task.wait(3)
        if autoKillEnabled and selectedAutoKillTarget ~= "" then
            local targetPlayer = Players:FindFirstChild(selectedAutoKillTarget)
            if targetPlayer then
                sendCommand("/kill " .. selectedAutoKillTarget)
            end
        end
    end
end)

-- ==========================================
-- 5. LOGIKA AUTO-USE & AUTO-GOD RESPAWN
-- ==========================================
local function useAllItemsOnce()
    local character = LocalPlayer.Character
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    
    if humanoid and backpack and humanoid.Health > 0 then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") then
                humanoid:EquipTool(item)
                task.wait(0.1)
                item:Activate()
                task.wait(0.2)
            end
        end
        for _, item in ipairs(character:GetChildren()) do
            if item:IsA("Tool") then 
                item:Activate()
                task.wait(0.2) 
            end
        end
    end
end

-- Event Saat Respawn
LocalPlayer.CharacterAdded:Connect(function(newCharacter)

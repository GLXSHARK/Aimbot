-- 2. FUNGSI NOTIFIKASI OTOMATIS HAPUS
-- ==========================================
local function SendNotification(titleText, descText, color)
    local notif = Instance.new("Frame")
    notif.Size = UDim2.new(1, 0, 0, 50)
    notif.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    notif.BackgroundTransparency = 1
    notif.Parent = NotifContainer

    local nCorner = Instance.new("UICorner")
    nCorner.CornerRadius = UDim.new(0, 6)
    nCorner.Parent = notif

    local sideBar = Instance.new("Frame")
    sideBar.Size = UDim2.new(0, 4, 1, 0)
    sideBar.BackgroundColor3 = color
    sideBar.BorderSizePixel = 0
    sideBar.BackgroundTransparency = 1
    sideBar.Parent = notif
    
    local sbCorner = Instance.new("UICorner")
    sbCorner.CornerRadius = UDim.new(0, 6)
    sbCorner.Parent = sideBar

    local nTitle = Instance.new("TextLabel")
    nTitle.Size = UDim2.new(1, -15, 0, 18)
    nTitle.Position = UDim2.new(0, 12, 0, 8)
    nTitle.BackgroundTransparency = 1
    nTitle.Text = titleText
    nTitle.TextColor3 = color
    nTitle.Font = Enum.Font.GothamBold
    nTitle.TextSize = 12
    nTitle.TextXAlignment = Enum.TextXAlignment.Left
    nTitle.TextTransparency = 1
    nTitle.Parent = notif

    local nDesc = Instance.new("TextLabel")
    nDesc.Size = UDim2.new(1, -15, 0, 18)
    nDesc.Position = UDim2.new(0, 12, 0, 24)
    nDesc.BackgroundTransparency = 1
    nDesc.Text = descText
    nDesc.TextColor3 = Color3.fromRGB(200, 200, 200)
    nDesc.Font = Enum.Font.Gotham
    nDesc.TextSize = 11
    nDesc.TextXAlignment = Enum.TextXAlignment.Left
    nDesc.TextTransparency = 1
    nDesc.Parent = notif

    TweenService:Create(notif, TweenInfo.new(0.4), {BackgroundTransparency = 0.1}):Play()
    TweenService:Create(sideBar, TweenInfo.new(0.4), {BackgroundTransparency = 0}):Play()
    TweenService:Create(nTitle, TweenInfo.new(0.4), {TextTransparency = 0}):Play()
    TweenService:Create(nDesc, TweenInfo.new(0.4), {TextTransparency = 0}):Play()

    task.delay(3.5, function()
        TweenService:Create(notif, TweenInfo.new(0.4), {BackgroundTransparency = 1}):Play()
        TweenService:Create(sideBar, TweenInfo.new(0.4), {BackgroundTransparency = 1}):Play()
        TweenService:Create(nTitle, TweenInfo.new(0.4), {TextTransparency = 1}):Play()
        local outTween = TweenService:Create(nDesc, TweenInfo.new(0.4), {TextTransparency = 1})
        outTween:Play()
        outTween.Completed:Wait()
        notif:Destroy()
    end)
end


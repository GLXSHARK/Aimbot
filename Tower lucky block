    end
    
    if autoGodEnabled then
        SendNotification("Auto God Mode", "Mengaktifkan God Mode...", Color3.fromRGB(52, 152, 219))
        task.spawn(function()
            sendCommand("/God me")
            task.wait(0.3)
            sendCommand("/ff")
            task.wait(0.3)
            sendCommand("/health me 999999")
        end)
    end
end)

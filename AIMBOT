-- ==================== TARGETING & WALL CHECK LOGIC ====================

local function IsVisible(targetPart, targetCharacter)
    if not LocalPlayer.Character then return false end
    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
    local origin = Camera.CFrame.Position
    local direction = (targetPart.Position - origin)
    local rayResult = workspace:Raycast(origin, direction, raycastParams)
    
    if rayResult then
        return rayResult.Instance:IsDescendantOf(targetCharacter)
    end
    return true
end

local function GetClosestTargetInCenterFOV()
    local closestTarget = nil
    local shortestDistance = FOVRadius
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local humanoid = char:FindFirstChildOfClass("Humanoid")

            -- Cek Status Hidup Real-Time
            if humanoid and humanoid.Health > 0 and char:IsDescendantOf(workspace) then
                local targetPart = nil
                
                if LockHead then
                    targetPart = char:FindFirstChild("Head")
                else
                    targetPart = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
                end

                if targetPart then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                    
                    if onScreen then
                        local distance = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                        if distance <= shortestDistance then
                            if IsVisible(targetPart, char) then
                                shortestDistance = distance
                                closestTarget = targetPart
                            end
                        end
                    end
                end
            end
        end
    end
    return closestTarget
end

-- ==================== DYNAMIC EVENT-DRIVEN ESP SYSTEM ====================

local function RemoveESP(player)
    if ESPHighlights[player] then
        ESPHighlights[player]:Destroy()
        ESPHighlights[player] = nil
    end
end

local function ApplyHighlight(player, character)
    if player == LocalPlayer then return end
    RemoveESP(player)

    if not ESPEnabled then return end

    local humanoid = character:WaitForChild("Humanoid", 3)
    if humanoid and humanoid.Health > 0 then
        local hl = Instance.new("Highlight")
        hl.Name = "DynamicESP"
        hl.FillColor = Color3.fromRGB(203, 166, 247)
        hl.FillTransparency = 0.65
        hl.OutlineColor = Color3.fromRGB(137, 180, 250)
        hl.OutlineTransparency = 0.1
        hl.Adornee = character
        hl.Parent = character
        ESPHighlights[player] = hl

        -- Event saat player mati saat bermain
        local diedConn
        diedConn = humanoid.Died:Connect(function()
            RemoveESP(player)
            if diedConn then diedConn:Disconnect() end
        end)
    end
end

local function TrackPlayer(player)
    if player == LocalPlayer then return end
    PlayerConnections[player] = {}

    -- Handle Karakter Saat Ini
    if player.Character then
        task.spawn(ApplyHighlight, player, player.Character)
    end

    -- Handle Respawn Player
    local charAddedConn = player.CharacterAdded:Connect(function(newChar)
        task.spawn(ApplyHighlight, player, newChar)
    end)

    table.insert(PlayerConnections[player], charAddedConn)
end

-- Deteksi Player Baru Join & Player yang Ada Sekarang
for _, player in ipairs(Players:GetPlayers()) do
    TrackPlayer(player)
end

Players.PlayerAdded:Connect(TrackPlayer)

Players.PlayerRemoving:Connect(function(player)
    RemoveESP(player)
    if PlayerConnections[player] then
        for _, conn in ipairs(PlayerConnections[player]) do
            if conn then conn:Disconnect() end
        end
        PlayerConnections[player] = nil
    end
end)

-- ==================== MAIN LOOP ====================

renderConnection = RunService.RenderStepped:Connect(function()
    FOVCircle.Size = UDim2.new(0, FOVRadius * 2, 0, FOVRadius * 2)

    -- Sembunyikan/Tampilkan Semua Highlight ESP Sesuai State
    for player, hl in pairs(ESPHighlights) do
        if hl and hl.Parent then
            hl.Enabled = ESPEnabled
        end
    end

    -- Eksekusi Auto Lock
    if AutoLockEnabled then
        local targetPart = GetClosestTargetInCenterFOV()
        if targetPart then
            local currentCF = Camera.CFrame
            local targetCF = CFrame.new(currentCF.Position, targetPart.Position)
            
            if InstantLock then
                Camera.CFrame = targetCF
            else
                Camera.CFrame = currentCF:Lerp(targetCF, 0.25)
            end
        end
    end
end)

        FloatLockBtn.BackgroundColor3 = AutoLockEnabled and Color3.fromRGB(166, 227, 161) or Color3.fromRGB(243, 139, 168)
        FloatLockBtn.TextColor3 = AutoLockEnabled and Color3.fromRGB(30, 30, 46) or Color3.fromRGB(255, 255, 255)
        FloatLockBtn.Text = AutoLockEnabled and Lang.FloatLockOn or Lang.FloatLockOff
    end

    local function UpdateESPState(state)
        ESPEnabled = state
